# reaped-whirlwind environment — copy to .env and fill in.  .env is GITIGNORED.
# This file is the canonical list of every variable the stack reads.

# Timezone + Synology user/group (for file ownership on the NAS)
TZ=America/Chicago
PUID=106808
PGID=106808

# Radar image processor
PROCESSING_MODE=normal
SAMPLE_RATE=4

# Weather reporter (NWS API). NWS REQUIRES a real contact in the User-Agent.
NWS_REGION=DFW
NWS_LAT=32.8968
NWS_LON=-97.0380
NWS_UA=(reaped-whirlwind weather-reporter, you@example.com)
WEATHER_INTERVAL=600

# ---- Alerting (Part C) ------------------------------------------------------
# Which NWS event types trigger an email/SMS. Comma-separated; whitespace is
# trimmed. Each entry must match the NWS `properties.event` string EXACTLY.
# This is an OVERRIDE knob: the canonical default is DEFAULT_ALLOWED_EVENTS in
# common/nws.py (the eight standard severe-weather Warnings most relevant in
# DFW), repeated below for visibility. Watches and advisories are excluded by
# default; add them here to opt in.
ALLOWED_EVENTS=Tornado Warning,Severe Thunderstorm Warning,Flash Flood Warning,Flood Warning,High Wind Warning,Winter Storm Warning,Ice Storm Warning,Extreme Wind Warning

# Per-event-type rolling cap. 86400 = 24 h. Once we've sent for an event type
# within this window, additional alerts of that type (new alert_ids) are
# suppressed (and recorded in the ledger with outcome="suppressed_daily_cap")
# — UNLESS the type is in DAILY_CAP_BYPASS_EVENTS below.
DAILY_CAP_SECONDS=86400

# Event types exempt from the daily cap entirely. Default "Tornado Warning": a
# DFW outbreak issues several sequential tornado warnings for one point, and
# warning #2 onward must still reach the phone. Bypassed types still respect
# per-alert_id dedupe and the per-cycle cap of 5.
# Independent of COOL_OFF_BYPASS_EVENTS — a type may be in one, both or neither.
DAILY_CAP_BYPASS_EVENTS=Tornado Warning

# Global cool-off across all event types. 1800 = 30 min. After ANY send,
# subsequent sends are deferred until the cool-off elapses — EXCEPT for events
# in COOL_OFF_BYPASS_EVENTS. Deferred alerts are NOT written to the ledger
# (they retry next poll cycle). The cool-off is CROSS-TYPE, so by default every
# Warning in the allowlist bypasses it (a flood email must not hold a severe-
# storm email back 30 min); it only throttles watches/advisories you opt into.
COOL_OFF_SECONDS=1800
COOL_OFF_BYPASS_EVENTS=Tornado Warning,Severe Thunderstorm Warning,Flash Flood Warning,Flood Warning,High Wind Warning,Winter Storm Warning,Ice Storm Warning,Extreme Wind Warning

# api.weather.gov 502s / timeouts: retries inside the poll cycle, with doubling
# backoff. /health shows nws_consecutive_failures + nws_last_attempts.
NWS_RETRIES=2
NWS_RETRY_BACKOFF_SECONDS=3

# CNN readout on Tornado Warning emails/SMS. "off" = withdrawn (no score, the
# email says so). OFF on kappa since 2026-09-06: models/v1 failed the replay
# smoke test (services/inference/replay_smoke.py). Turn on only with a model
# that passes it. See docs/MODEL_CARD.md "Invalidation".
MODEL_ANNOTATION=off

# Email / SMTP. The alerting layer sends NWS warnings with the model score as
# a numeric annotation (Tornado Warning only — for other events the model
# readout is N/A since the model only assesses tornado risk on KFWS radar).
# For Gmail, SMTP_PASS must be an App Password (16-char, requires 2FA on the account).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=<gmail-app-password>
ALERT_FROM=you@gmail.com

# Comma-separated recipient lists. ALERT_TO gets the FULL email body
# (NWS warning + model annotation); ALERT_TO_SMS gets a ~140-char
# subject+body suitable for an email→SMS carrier gateway.
#
# WARNING: type each ALERT_TO address EXACTLY — Gmail ignores dots but not a
# missing letter, and a wrong-but-valid-looking address is still accepted by
# the SMTP server (recorded "ok"), so the SMS arrives while the email silently
# goes nowhere. If you get the SMS but no email, check this address first.
# See services/alerting/AGENT.md ("Gotcha").
# Example carrier gateways for a number like 7072874226:
#   AT&T:        7072874226@txt.att.net
#   Verizon:     7072874226@vtext.com
#   T-Mobile:    7072874226@tmomail.net
#   Google Fi:   7072874226@msg.fi.google.com
ALERT_TO=you@gmail.com
ALERT_TO_SMS=

# Model inference (Part C)
# Annotation threshold (NOT a safety threshold). Lowering it just makes the
# "elevated" annotation easier to reach; it does not affect whether an email
# is sent (NWS warning gates that). See docs/MODEL_CARD.md "Tuning" for the
# precision/recall trade-off and the 0.5 alternative.
MODEL_RISK_THRESHOLD=0.8

# Inference cycle cadence (seconds). 300 matches IEM RIDGE's typical N0B
# refresh; the alerting service polls at the same cadence by default.
INFERENCE_POLL_INTERVAL=300
ALERTING_POLL_INTERVAL=300

# ---- Operational logs (month-rotated JSONL on the existing *-logs mounts) ----
# The status files hold only the LATEST state; these are the durable history.
# Both are best-effort: if the mount is missing or read-only the service logs
# once and keeps working. Old months are never pruned automatically.
#   scores-YYYYMM.jsonl    one line per inference cycle (~105 KB/month)
#   decisions-YYYYMM.jsonl one line per alerting outcome (sent / suppressed /
#                          deferred / nws_error / smtp_error)
SCORE_LOG_PATH=/logs/scores.jsonl
DECISION_LOG_PATH=/logs/decisions.jsonl

# Cached N0B/N0S PNGs under inference-state/current are re-fetched every cycle
# and never re-read, so they exist only for post-hoc inspection. Files older
# than this are unlinked at the end of each cycle (0 disables pruning).
# Unbounded, this directory reached 2.5 GB / 45k files in 101 days.
STATE_RETENTION_DAYS=14

# N0B/N0S temporal-pairing window (seconds). If no N0S is available within
# this many seconds of the latest N0B, the inference cycle skips scoring
# (does NOT substitute a stale velocity scan).
MAX_PAIR_DELTA_SECONDS=300

# A model score this old is treated as "unavailable" by the alerting service
# (and surfaced as "stale" by /health). 1800s = 30 min.
MAX_SCORE_AGE_SECONDS=1800

# KFWS WSR-88D coordinates (used by both inference for cropping and alerting
# for the NWS /alerts/active?point=... query). Canonical defaults: common/nws.py.
KFWS_LAT=32.5728
KFWS_LON=-97.3031

# Optional: SHA256 of models/v1/model.pt. If set, the inference service
# refuses to start unless model.pt matches. Falls back to manifest.json.
# MODEL_FINGERPRINT=

# ---- MRMS rotation readout (docs/MRMS_MIGRATION.md) ----
# Low-level azimuthal shear product from NOAA, 2-min cadence, multi-radar.
# Replaces the withdrawn CNN (models/v1) as the experimental annotation.
# Rotation service (port 9010) fetches, decodes, and serves diagnostics.
# All settings optional (defaults shown); uncomment to override.
#
# Poll interval in seconds; NCEP is ~2 min apart.
# ROTATION_POLL_INTERVAL=120
#
# Max age of last score before /health downgrades to "stale" (seconds).
# Tighter than CNN's 1800 because MRMS is 2-min cadence.
# ROTATION_MAX_SCORE_AGE_SECONDS=900
#
# Azimuthal shear threshold in s^-1 to flag as "elevated" in alerts.
# Chosen via Phase 1 backtest (docs/MRMS_MIGRATION.md §3).
# ROTATION_THRESHOLD=0.015
#
# Domain radius in km around KFWS for computing max and top cells.
# DOMAIN_RADIUS_KM=100
#
# Include RotationTrack30min (30-min rolling max) in the readout.
# ROTATION_TRACK=1
